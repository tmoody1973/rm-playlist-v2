# ========================================================================
# rm-playlist-v2 — environment variables
#
# Copy to `.env.local` (gitignored) and fill in the blanks. Grouped by which
# runtime reads them: Next.js picks up its vars from the dev server directly;
# Convex, Trigger.dev, Fly, and Cloudflare vars must be pushed to each
# platform's env store separately (`bunx convex env set`, Trigger project
# env, etc.). Keys that already have values here are public identifiers.
# ========================================================================


# ===== Next.js runtime (read by `bun dev` from apps/web) =================
# Public (exposed to browser bundle — safe):
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only (never exposed to browser):
CLERK_SECRET_KEY=


# ===== Convex deployment info (used by `bunx convex dev` CLI) ===========
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
# For CI production deploys (Milestone 6):
# CONVEX_DEPLOY_KEY=


# ===== Trigger.dev (read by `bunx trigger.dev@latest dev` CLI) ==========
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=


# ===== Apple Music API (pushed to Convex env — preview source) ==========
# Verified end-to-end via scripts/verify-apple-music.ts.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=


# ===== SGmetadata (pushed to Convex env — authoritative playlist source) ===
# Per official StreamGuys PDF (page 2 + page 13): ONE API key per account,
# ONE scraper UUID per station. API key lives in the URL path (effectively
# a bearer token). Base URL is universal (`https://jetapi.streamguys.com`)
# — don't override unless StreamGuys tells you to.
#
# API key = env var (secret, bearer-like).
# The 4 scraper UUIDs (HYFIN, 88Nine, Rhythm Lab, 414 Music) are identifiers,
# NOT secrets — they seed into Convex `ingestionSources.config.scraperUuid`
# during Milestone 4.
SGMETADATA_API_KEY=


# ===== SGmetadata per-station scraper UUIDs (reference only) ============
# CORRECTION 2026-04-23: these values were initially labeled as Spinitron
# keys, but they're actually SGmetadata scraper UUIDs. Already seeded into
# Convex `ingestionSources.config.scraperUuid` for all 4 stations during
# Milestone 4. Kept here as a backup reference — the DB is the live source.
# Scraper UUIDs are identifiers (not secrets); this file is still
# gitignored, but even if leaked these would just be opaque DB IDs.
HYFIN_SGMETADATA_SCRAPER_UUID=
STATION_88NINE_SGMETADATA_SCRAPER_UUID=
STATION_414MUSIC_SGMETADATA_SCRAPER_UUID=
RHYTHMLAB_SGMETADATA_SCRAPER_UUID=


# ===== Spinitron per-station API keys (supplementary source, Week 3+) ===
# Real Spinitron API tokens are opaque alphanumeric strings (~20 chars),
# NOT UUIDs. Fill in when pulling real tokens from each station's Spinitron
# admin panel (Admin → API Keys). Until then, Spinitron sources stay
# disabled in Convex.
SPINITRON_HYFIN_API_KEY=
SPINITRON_88NINE_API_KEY=
SPINITRON_RHYTHMLAB_API_KEY=


# ===== ICY stream URLs (pushed to Fly + Convex env, Week 3+) ============
# Public stream URLs — not technically secret, but env-var for consistency.
HYFIN_ICY_URL=
RHYTHMLAB_ICY_URL=


# ===== Spotify (pushed to Convex env — enrichment + deep-link ONLY) =====
# Used for canonical track metadata (ISRC, album art, spotify_track_id for
# "Listen on Spotify" deep-link). NOT a preview source (Apple Music handles
# that — see DESIGN.md decisions log).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ===== Ticketmaster (pushed to Convex env, Week 5 events) ===============
# Discovery API. Free tier ~5k requests/day.
TICKETMASTER_CONSUMER_SECRET=
TICKETMASTER_CONSUMER_KEY=



# ===== AXS (pushed to Convex env, Week 5 events — Pabst Theater Group) ==
AXS_ACCESS_TOKEN=
# AXS_PARTNER_ID=


# ===== Cloudflare (widget CDN) ==========================================
# Account ID is public-ish; API token is GitHub Actions secret only (Milestone 7).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# ========================================================================
# NOT stored here:
#   - .p8 file contents (APPLE_MUSIC_PRIVATE_KEY is the PATH; file lives at ~/.gstack/secrets/)
#   - Per-stream scraper UUIDs (DB values, seeded into Convex `ingestionSources`)
#   - User OAuth tokens (Clerk manages per-user)
# ========================================================================


# ── NPR Cadence (music-rights reporting + live playlist push) ─────────────
# OAuth2 client-credentials: POST /api/cadence/auth/token with clientId +
# clientSecret returns a short-lived Bearer JWT. Spec (public):
#   https://cadence.nprstations.org/api-docs/station-admin
# Channel IDs are identifiers, not secrets. Only WYMS (88Nine) and HYFIN exist
# in Cadence as of 2026-09-11; 414 Music and Rhythm Lab have no channel.
# Read by: Trigger.dev tasks (future cadence push) — needs sync to Trigger env.
CADENCE_BASE_URL=https://cadence.nprstations.org
CADENCE_CLIENT_ID=
CADENCE_CLIENT_SECRET=
CADENCE_CHANNEL_ID_88NINE=8d499a14-4313-4b41-8ba9-474d69f98b89
CADENCE_CHANNEL_ID_HYFIN=61e85d0c-5f85-402a-8898-1fc1206a390a
